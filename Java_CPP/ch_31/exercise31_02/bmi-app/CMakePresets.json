{
  "version": 3,
  "configurePresets": [
    {
      "name": "win-x86-release",
      "displayName": "Windows x86 (Release)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/win-x86",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
